# Copy to .env for local runs. Never commit .env.
NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
DATA_DIR=.
ALLOWED_ORIGINS=https://tejas67-hydra.github.io,http://localhost:12000
# Optional: enables /api/tts so the apps can speak without exposing the key in the browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
